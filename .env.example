# ── Entorno ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de Datos (PostgreSQL) ────────────────────────────────────────────
# Desarrollo local con Docker:
DATABASE_URL="postgresql://clubaridane:devpassword@localhost:5432/clubaridane_dev"
# SSH Tunnel al VPS (alternativa):
# DATABASE_URL="postgresql://clubaridane_user:PASSWORD@localhost:5432/clubaridane_db"

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="cambia_esto_por_una_clave_muy_larga_y_aleatoria_dev"
JWT_REFRESH_SECRET="cambia_esto_por_otra_clave_diferente_y_aleatoria_dev"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ──────────────────────────────────────────────────────────────────
# Desarrollo: origen del dev server de Vite
CORS_ORIGIN=http://localhost:5173

# ── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Email (Nodemailer - opcional) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@clubaridane.es
SMTP_PASS=tu_app_password
EMAIL_FROM="Club Aridane <noreply@clubaridane.es>"

# ── Admin inicial (usado por prisma/seed.ts) ──────────────────────────────
# Contraseña para el usuario admin que se crea al ejecutar 'pnpm db:seed'
# IMPORTANTE: Usa una contraseña segura y única en producción
ADMIN_PASSWORD=cambia_esto_por_una_contraseña_segura_y_unica
